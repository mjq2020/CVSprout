# Local Compose startup. The launcher selects CPU or NVIDIA automatically.
MDP_PORT=8000
MDP_BIND_ADDRESS=127.0.0.1
MDP_GPU_DEVICES=0
MDP_AUTH_MODE=accounts
MDP_COOKIE_SECURE=false
MDP_PUBLIC_ORIGIN=
# Optional HTTP(S) proxy reachable from inside the container, for model downloads.
MDP_DOWNLOAD_PROXY=

# Releases fill these in automatically. Source checkout builds local images.
MDP_IMAGE_PREFIX=cvsprout
MDP_VERSION=local

# Source development only; Compose uses persistent /data and /models volumes.
MDP_DATA_DIR=./data
MDP_MODELS_DIR=./models
MDP_MODEL_DEVICE=auto
MDP_EMBEDDED_WORKER=true
MDP_EMBEDDED_PIPELINE_WORKER=true
MDP_RELEASE_GPU_AFTER_INFERENCE=true
MDP_TRAINING_ENABLED=true

# Optional SAM3: models/sam3/sam3.pt and source at models/sam3/source.
# Existing installations can override MDP_SAM3_CHECKPOINT / MDP_SAM3_SOURCE_DIR.
# Training weights: models/training/*.pt. Custom directories: MDP_TRAINING_MODEL_DIRS.
QWEN_BASE_URL=
QWEN_API_KEY=
QWEN_MODEL=Qwen/Qwen3.5-35B-A3B
