# Local Compose startup. The launcher selects CPU or NVIDIA automatically.
# Launchers support --port / -Port; occupied ports fall back automatically.
# A successful start saves the actual port here. Use --strict-port / -StrictPort to disable fallback.
MDP_PORT=8000
MDP_BIND_ADDRESS=127.0.0.1
MDP_GPU_DEVICES=0
MDP_AUTH_MODE=accounts
MDP_COOKIE_SECURE=false
MDP_PUBLIC_ORIGIN=
# Comma-separated proxy source IPs/CIDRs as seen by the Web container; never use * on a public listener.
MDP_TRUSTED_PROXIES=127.0.0.1
# JSON/API request budget; image/ZIP batches use MDP_MAX_UPLOAD_MB plus 1 MiB for multipart headers.
MDP_MAX_REQUEST_MB=16
MDP_MAX_UPLOAD_MB=250
# Optional HTTP(S) proxy reachable from inside the container, for model downloads.
MDP_DOWNLOAD_PROXY=

# Releases fill these in automatically. Source checkout builds local images.
MDP_IMAGE_PREFIX=cvsprout
MDP_VERSION=local

# Source development only; Compose uses persistent /data and /models volumes.
MDP_DATA_DIR=./data
MDP_MODELS_DIR=./models
MDP_MODEL_DEVICE=auto
MDP_EMBEDDED_WORKER=true
MDP_EMBEDDED_PIPELINE_WORKER=true
MDP_RELEASE_GPU_AFTER_INFERENCE=true
MDP_TRAINING_ENABLED=true

# SAM weights are supplied manually: models/sam2/sam2.1_t.pt and models/sam3/sam3.pt.
# SAM3 requires access approval from its official model page; no automatic SAM download.
# Override MDP_SAM2_CHECKPOINT / MDP_SAM3_CHECKPOINT if needed.
# Legacy official SAM3 SDK users may keep MDP_SAM3_SOURCE_DIR; it is not needed by the default backend.
# Training weights: models/training/*.pt. Custom directories: MDP_TRAINING_MODEL_DIRS.
# Qwen3.5 uses local weights by default; set QWEN_BASE_URL to retain a remote API service.
QWEN_BASE_URL=
QWEN_API_KEY=
QWEN_MODEL=Qwen/Qwen3.5-35B-A3B
